# Stella GPU deployment on AI1 (compose.gpu.yaml). Copy to .env on AI1 and edit:
#   cp .env.gpu.example .env
# Create/edit .env ON THE SERVER (or save it with LF line endings): Windows CRLF
# line endings put a hidden \r into values such as the API keys.
# .env is gitignored. Never commit real keys.
#
# The CPU laptop workflow uses .env.example + compose.yaml and is not affected.

# --- Secrets (required) -------------------------------------------------------
# Shared by the orchestrator and vLLM. compose.gpu.yaml refuses to start without it.
# Generate one, e.g.:  openssl rand -hex 32   (or: python3 -c "import secrets; print(secrets.token_hex(32))")
QWEN_API_KEY=
# Optional but recommended: shared by the orchestrator and the musetalk service.
MUSETALK_API_KEY=

# --- GPU selection ------------------------------------------------------------
# Host GPU index (nvidia-smi). Inside each container that GPU is cuda:0.
STELLA_GPU_ID=0

# --- Storage (paths on the Docker host, relative to this folder or absolute) ---
# Whisper .pt files + Hugging Face cache (Qwen3, Kokoro) under <dir>/huggingface.
STELLA_MODELS_DIR=./models
# MuseTalk weights (download_weights.sh writes here).
MUSETALK_MODELS_DIR=./musetalk/models

# --- Qwen3 on vLLM ------------------------------------------------------------
# Leave unset: compose.gpu.yaml pins vllm/vllm-openai:v0.33.0 by digest. Set only when
# the image was moved with docker save/load (the loaded copy has no registry digest):
# VLLM_IMAGE=vllm/vllm-openai:v0.33.0
# Official Qwen FP8 checkpoint (~9 GB weights). On the L40 (Ada) vLLM runs this
# block-FP8 format through a fallback kernel (see DEPLOY_GPU.md, risks).
# Alternatives: Qwen/Qwen3-8B (BF16, ~16.4 GB: raise VLLM_GPU_MEMORY_UTILIZATION to ~0.45),
#               Qwen/Qwen3-4B (BF16, ~8 GB).
QWEN_MODEL=Qwen/Qwen3-8B-FP8
# Fraction of the WHOLE GPU vLLM may claim (weights + KV cache + CUDA graphs).
# 0.35 x 46 GB = ~16 GB. Change only after measuring (DEPLOY_GPU.md step 6).
VLLM_GPU_MEMORY_UTILIZATION=0.35
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=4
# 1 after the weights are pre-downloaded: vLLM then never contacts Hugging Face.
HF_HUB_OFFLINE=0
# Default reply cap for single requests (AI Lab); voice turns use CONVERSATION_MAX_NEW_TOKENS.
QWEN_MAX_NEW_TOKENS=256
# Empty = built-in prompt ("You are Stella, a friendly voice assistant. ...").
QWEN_SYSTEM_PROMPT=

# --- Whisper (CUDA, FP16) -----------------------------------------------------
# large-v3-turbo: ~1.6 GB download, good accuracy/speed. Smaller: small, medium.
WHISPER_MODEL=large-v3-turbo

# --- Kokoro (CUDA) ------------------------------------------------------------
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0

# --- MuseTalk avatar ----------------------------------------------------------
MUSETALK_ENABLED=true
# avatars/<id>/reference.mp4 must exist on AI1 (not in git; see DEPLOY_GPU.md).
MUSETALK_AVATAR_ID=stella
# Frames per GPU batch; lower (e.g. 8) to reduce MuseTalk's VRAM.
MUSETALK_BATCH_SIZE=20
MUSETALK_MAX_AUDIO_SECONDS=60
MUSETALK_PREPARE_ON_START=true
MUSETALK_TIMEOUT=180
AVATAR_VIDEO_TTL_MINUTES=60
HF_ENDPOINT=https://huggingface.co

# --- Orchestrator / conversation -----------------------------------------------
CONVERSATION_HISTORY_MESSAGES=6
CONVERSATION_MAX_NEW_TOKENS=96
SERVICE_TIMEOUT_SECONDS=120
MAX_UPLOAD_MB=25
# The web UI has NO authentication. Keep 127.0.0.1 and use an SSH tunnel / RDP
# session; browsers also allow the microphone only on https:// or localhost.
STELLA_BIND_ADDRESS=127.0.0.1
STELLA_PORT=8000
# Optional HTTPS (lets testers on other machines use the microphone without an SSH
# tunnel). Put cert + key in ./certs (gitignored) and point at their container paths:
# STELLA_TLS_CERTFILE=/app/certs/stella.crt
# STELLA_TLS_KEYFILE=/app/certs/stella.key
# With HTTPS you may set STELLA_BIND_ADDRESS=0.0.0.0, but the page still has NO login:
# only do that on a trusted internal network / firewall-restricted host.
STELLA_TLS_CERTFILE=
STELLA_TLS_KEYFILE=
