# Copy to .env to override the defaults in compose.yaml.

# Whisper speech-to-text (whisper service)
WHISPER_MODEL=base

# Qwen3 LLM (qwen service). Any Qwen3 Hugging Face ID works, e.g. Qwen/Qwen3-1.7B (needs more RAM).
QWEN_MODEL=Qwen/Qwen3-0.6B
QWEN_MAX_NEW_TOKENS=256

# Kokoro TTS (kokoro service). English voices only: a* = American, b* = British (e.g. af_heart, am_michael, bf_emma).
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0

# Orchestrator -> model service URLs (Compose network names). Point these at
# other hosts later to move a model onto a separate (GPU) machine.
WHISPER_URL=http://whisper:8001
QWEN_URL=http://qwen:8002
KOKORO_URL=http://kokoro:8003
SERVICE_TIMEOUT_SECONDS=300

# Audio upload limit (orchestrator and whisper service)
MAX_UPLOAD_MB=25

# Browser conversation: earlier messages sent to Qwen3, and reply length cap.
CONVERSATION_HISTORY_MESSAGES=6
CONVERSATION_MAX_NEW_TOKENS=96

# ---------------------------------------------------------------------------
# MuseTalk avatar (the "musetalk" service, NVIDIA GPU host only; see musetalk/README.md).
#
# CPU-only machine (e.g. the dev laptop): leave as below -> voice-only.
# GPU host: uncomment COMPOSE_PROFILES=gpu and set MUSETALK_ENABLED=true, then
#   `docker compose up -d` starts all five services.
# COMPOSE_PROFILES=gpu
MUSETALK_ENABLED=false
MUSETALK_SERVICE_URL=http://musetalk:8010
# Per reply: render + MP4 transfer. Raise for long replies on a slow GPU.
MUSETALK_TIMEOUT=180
# avatars/<id>/reference.mp4 (or .png); also the avatar prepared at startup.
MUSETALK_AVATAR_ID=stella
# Optional: the service is only reachable on the internal Compose network.
# If set, both the orchestrator and musetalk use it automatically (same .env).
MUSETALK_API_KEY=
# Frames per GPU batch; lower (e.g. 8) if the GPU runs out of memory.
MUSETALK_BATCH_SIZE=20
MUSETALK_GPU_ID=0
MUSETALK_MAX_AUDIO_SECONDS=60
# Prepare the default avatar when the service starts (otherwise on the first request).
MUSETALK_PREPARE_ON_START=true
# Hugging Face endpoint for download_weights.sh (the official script uses https://hf-mirror.com).
HF_ENDPOINT=https://huggingface.co
# How long generated avatar videos stay available under output/avatar_videos/.
AVATAR_VIDEO_TTL_MINUTES=60
